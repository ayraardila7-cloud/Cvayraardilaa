<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CV & Portofolio - Ayra Ardilacv</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome untuk Ikon -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <!-- Google Fonts: Plus korea Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* Pengaturan khusus saat dicetak atau disimpan sebagai PDF (Ctrl+P) */
    @media print {
      body {
        background: #ffffff !important;
        color: #111827 !important;
        font-size: 11pt;
      }
      .no-print {
        display: none !important;
      }
      section {
        padding-top: 1rem !important;
        padding-bottom: 1rem !important;
        page-break-inside: avoid;
      }
      .shadow-sm, .shadow-md, .shadow-lg {
        box-shadow: none !important;
        border: 1px solid #e5e7eb !important;
      }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-300">

  <!-- NAVBAR -->
  <header class="no-print sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="#" class="text-xl font-extrabold tracking-tight text-indigo-600 dark:text-indigo-400">
        Ayra<span class="text-slate-800 dark:text-white">.CV</span>
      </a>

      <!-- Menu Desktop -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href="#tentang" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Tentang</a>
        <a href="#pengalaman" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Pengalaman</a>
        <a href="#pendidikan" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Pendidikan</a>
        <a href="#keahlian" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Keahlian</a>
        <a href="#portofolio" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Portofolio</a>
        <a href="#kontak" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Kontak</a>
      </nav>

      <!-- Tombol Dark Mode & Mobile Menu -->
      <div class="flex items-center gap-3">
        <button id="theme-toggle" aria-label="Ganti Tema" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
          <i id="theme-icon" class="fa-solid fa-moon"></i>
        </button>
        <button id="mobile-menu-btn" aria-label="Menu" class="md:hidden p-2 rounded-lg bg-slate-100 dark:bg-slate-800">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>

    <!-- Menu Mobile -->
    <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 space-y-2 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 text-sm font-medium">
      <a href="#tentang" class="block py-2 hover:text-indigo-600">Tentang</a>
      <a href="#pengalaman" class="block py-2 hover:text-indigo-600">Pengalaman</a>
      <a href="#pendidikan" class="block py-2 hover:text-indigo-600">Pendidikan</a>
      <a href="#keahlian" class="block py-2 hover:text-indigo-600">Keahlian</a>
      <a href="#portofolio" class="block py-2 hover:text-indigo-600">Portofolio</a>
      <a href="#kontak" class="block py-2 hover:text-indigo-600">Kontak</a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-16">

    <!-- HERO SECTION -->
    <section id="tentang" class="flex flex-col-reverse md:flex-row items-center justify-between gap-8 pt-4">
      <div class="space-y-4 text-center md:text-left flex-1">
        <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-300">
          Tersedia untuk Peluang Baru
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
          Ayra ardila
        </h1>
        <p class="text-lg sm:text-xl font-semibold text-indigo-600 dark:text-indigo-400">
          Frontend Web Developer & UI/UX Designer
        </p>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
          Pengembang web dengan pengalaman lebih dari 1 tahun dalam membangun antarmuka aplikasi web yang cepat, responsif, dan ramah pengguna. Berfokus pada efisiensi kode dan pengalaman pengguna yang intuitif.
        </p>

        <!-- Info Kontak Singkat (Tampil saat dicetak) -->
        <div class="flex flex-wrap justify-center md:justify-start gap-4 text-sm text-slate-600 dark:text-slate-400 pt-1">
          <span><i class="fa-solid fa-location-dot text-indigo-500 mr-1"></i> Jakarta, Indonesia</span>
          <span><i class="fa-solid fa-envelope text-indigo-500 mr-1"></i> ayraardila@email.com</span>
          <span><i class="fa-solid fa-phone text-indigo-500 mr-1"></i> +62 823-6408-1206</span>
        </div>

        <!-- Tombol Aksi -->
        <div class="no-print flex flex-wrap justify-center md:justify-start gap-3 pt-3">
          <button onclick="window.print()" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-sm transition flex items-center gap-2">
            <i class="fa-solid fa-file-pdf"></i> Unduh / Cetak CV
          </button>
          <a href="#kontak" class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold text-sm transition">
            Hubungi Saya
          </a>
        </div>
      </div>

      <!-- Foto Profil -->
      <div class="shrink-0">
        <div class="w-40 h-40 sm:w-48 sm:h-48 rounded-2xl overflow-hidden border-4 border-white dark:border-slate-800 shadow-lg bg-indigo-100 dark:bg-slate-800 flex items-center justify-center">
          <!-- Ganti src dengan URL foto Anda -->
          <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=yuda&backgroundColor=c7d2fe" alt="Foto Profil yuda" class="w-full h-full object-cover" />
        </div>
      </div>
    </section>

    <hr class="border-slate-200 dark:border-slate-800" />

    <!-- PENGALAMAN KERJA -->
    <section id="pengalaman" class="space-y-6">
      <h2 class="text-2xl font-bold flex items-center gap-2.5">
        <i class="fa-solid fa-briefcase text-indigo-600 dark:text-indigo-400"></i> Pengalaman Kerja
      </h2>

      <div class="space-y-6 border-l-2 border-indigo-200 dark:border-indigo-900 ml-3 pl-6">
        <!-- Item 1 -->
        <div class="relative bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="absolute -left-[33px] top-6 w-3.5 h-3.5 rounded-full bg-indigo-600 ring-4 ring-slate-50 dark:ring-slate-950"></span>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h3 class="text-lg font-bold">Frontend Developer</h3>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 w-fit">
              Jan 2027 – Sekarang
            </span>
          </div>
          <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-3">PT Teknologi jaringan Nusantara •panyabungan</p>
          <ul class="list-disc list-inside text-sm text-slate-600 dark:text-slate-300 space-y-1.5">
            <li>Mengembangkan aplikasi dashboard analitik berbasis web menggunakan React dan Tailwind CSS.</li>
            <li>Meningkatkan skor performa halaman (Lighthouse) dari 68 menjadi 95 melalui optimasi aset dan lazy loading.</li>
            <li>membuat website untuk mempermudah mengaks3s apapun</li>
          </ul>
        </div>

        <!-- Item 2 -->
        <div class="relative bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="absolute -left-[33px] top-6 w-3.5 h-3.5 rounded-full bg-slate-400 dark:bg-slate-600 ring-4 ring-slate-50 dark:ring-slate-950"></span>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h3 class="text-lg font-bold">Junior Web Developer</h3>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 w-fit">
              nov 2026 – Des 2027
            </span>
          </div>
          <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-3">CV Kreatif Media Solusi • medan</p>
          <ul class="list-disc list-inside text-sm text-slate-600 dark:text-slate-300 space-y-1.5">
            <li>mengerjakan tugas atau nilai nilai menggunakan excel bisa juga menghitung apapun dalam pekerjaan</li>
            <li>Melakukan pemeliharaan rutin, perbaikan bug, serta bisa membuat website </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- PENDIDIKAN & KEAHLIAN (2 KOLOM) -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- PENDIDIKAN -->
      <section id="pendidikan" class="space-y-6">
        <h2 class="text-2xl font-bold flex items-center gap-2.5">
          <i class="fa-solid fa-graduation-cap text-indigo-600 dark:text-indigo-400"></i> Pendidikan
        </h2>
        <div class="space-y-4">
          <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">2026 – 2030</span>
            <h3 class="text-base font-bold mt-1">S1 Teknik komputer jaringan</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400">Universitas Teknologi Indonesia</p>
            <p class="text-xs text-slate-500 mt-2">IPK: 3.78 / 4.00</p>
          </div>

          <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">Sertifikasi • 2026</span>
            <h3 class="text-base font-bold mt-1">Frontend Web Development Specialist</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400">Dicoding Academy</p>
          </div>
        </div>
      </section>

      <!-- KEAHLIAN -->
      <section id="keahlian" class="space-y-6">
        <h2 class="text-2xl font-bold flex items-center gap-2.5">
          <i class="fa-solid fa-code text-indigo-600 dark:text-indigo-400"></i> Keahlian
        </h2>
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
          <div>
            <h3 class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-2">Teknologi & Pemrograman</h3>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">HTML5 & CSS3</span>
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">JavaScript (ES6+)</span>
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Pemrograman</span>
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">paham excel</span>
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Git & GitHub</span>
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">ip adress</span>
            </div>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-2">Desain & Lainnya</h3>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">Figma</span>
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">Responsive Design</span>
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">Komunikasi Tim</span>
              <span class="px-3 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">Manajemen Waktu</span>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- PORTOFOLIO -->
    <section id="portofolio" class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <h2 class="text-2xl font-bold flex items-center gap-2.5">
          <i class="fa-solid fa-folder-open text-indigo-600 dark:text-indigo-400"></i> Portofolio Pilihan
        </h2>
        <!-- Filter Kategori -->
        <div class="no-print flex gap-2 text-xs font-semibold">
          <button onclick="filterProjects('all')" class="filter-btn px-3 py-1.5 rounded-lg bg-indigo-600 text-white">Semua</button>
          <button onclick="filterProjects('web')" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-800">Web App</button>
          <button onclick="filterProjects('ui')" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-800">UI/UX</button>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Proyek 1 -->
        <article data-category="web" class="project-card bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm flex flex-col">
          <div class="h-36 bg-gradient-to-tr from-indigo-600 to-purple-500 flex items-center justify-center text-white text-3xl">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <h3 class="font-bold text-base">Dashboard Keuangan UMKM</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1.5 leading-relaxed">
                Aplikasi pencatatan arus kas harian dan laporan laba rugi otomatis dengan grafik interaktif.
              </p>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
              <span class="text-indigo-600 dark:text-indigo-400 font-semibold">React • Tailwind</span>
              <a href="#" class="no-print hover:underline font-medium">Lihat Demo <i class="fa-solid fa-arrow-up-right-from-square ml-1"></i></a>
            </div>
          </div>
        </article>

        <!-- Proyek 2 -->
        <article data-category="web" class="project-card bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm flex flex-col">
          <div class="h-36 bg-gradient-to-tr from-emerald-500 to-teal-600 flex items-center justify-center text-white text-3xl">
            <i class="fa-solid fa-store"></i>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <h3 class="font-bold text-base">Katalog Kafe & Pemesanan QR</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1.5 leading-relaxed">
                Sistem menu digital berbasis web yang memudahkan pelanggan memesan langsung dari meja.
              </p>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
              <span class="text-emerald-600 dark:text-emerald-400 font-semibold">HTML • JS • API</span>
              <a href="#" class="no-print hover:underline font-medium">Lihat Demo <i class="fa-solid fa-arrow-up-right-from-square ml-1"></i></a>
            </div>
          </div>
        </article>

        <!-- Proyek 3 -->
        <article data-category="ui" class="project-card bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm flex flex-col">
          <div class="h-36 bg-gradient-to-tr from-amber-500 to-orange-600 flex items-center justify-center text-white text-3xl">
            <i class="fa-solid fa-mobile-screen-button"></i>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <h3 class="font-bold text-base">Redesign Aplikasi Transportasi</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1.5 leading-relaxed">
                Studi kasus perancangan ulang alur pemesanan tiket bus antarkota agar lebih ringkas.
              </p>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
              <span class="text-amber-600 dark:text-amber-400 font-semibold">Figma • Prototyping</span>
              <a href="#" class="no-print hover:underline font-medium">Studi Kasus <i class="fa-solid fa-arrow-up-right-from-square ml-1"></i></a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- KONTAK -->
    <section id="kontak" class="no-print bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="space-y-3">
          <h2 class="text-2xl font-bold">Mari Berkolaborasi</h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            ingin melamar pekerjaan ! dengan berbagai bidang kehalian
          </p>
          <div class="pt-2 flex items-center gap-2">
            <code id="email-text" class="px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-mono">ayra.ardila@gmail.com</code>
            <button onclick="copyEmail()" class="px-3 py-2 rounded-lg bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 text-xs font-semibold hover:bg-indigo-100 transition">
              <i class="fa-regular fa-copy mr-1"></i> Salin
            </button>
          </div>
          <div class="flex gap-4 pt-3 text-lg text-slate-500">
            <a href="#" aria-label="LinkedIn" class="hover:text-indigo-600 transition"><i class="fa-brands fa-linkedin"></i></a>
            <a href="#" aria-label="GitHub" class="hover:text-indigo-600 transition"><i class="fa-brands fa-github"></i></a>
            <a href="#" aria-label="Instagram" class="hover:text-indigo-600 transition"><i class="fa-brands fa-instagram"></i></a>
          </div>
        </div>

        <form id="contact-form" class="space-y-3">
          <input type="text" required placeholder="Nama Anda" class="w-full px-4 py-2.5 text-sm rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-indigo-500" />
          <input type="email" required placeholder="ayraardila@07gmail.com" class="w-full px-4 py-2.5 text-sm rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 foc
